APP_NAME=AuthkitDemo
APP_ENV=local
APP_KEY=
APP_DEBUG=true

APP_URL=http://localhost:8090
APP_HOST=127.0.0.1
APP_PORT=8090

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

# PostgreSQL (the package migrations are Postgres-specific)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=authkit_demo
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public

JWT_SECRET=demo-not-used-by-session-guard
