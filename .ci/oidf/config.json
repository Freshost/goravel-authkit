{
  "description": "Authkit OIDC provider",
  "alias": "authkit",
  "server": {
    "discoveryUrl": "https://localhost.emobix.co.uk:9443/oidc/.well-known/openid-configuration"
  },
  "client": {
    "client_id": "oidf-basic",
    "client_secret": "oidf-isolated-client-secret-not-for-production",
    "scope": "openid profile email"
  },
  "client2": {
    "client_id": "oidf-second",
    "client_secret": "oidf-isolated-client-secret-not-for-production",
    "scope": "openid profile email"
  },
  "client_secret_post": {
    "client_id": "oidf-post",
    "client_secret": "oidf-isolated-client-secret-not-for-production",
    "scope": "openid profile email"
  },
  "browser": [
    {
      "match": "https://localhost.emobix.co.uk:9443/oidc/authorize*",
      "tasks": [
        {
          "task": "Reject unregistered redirect",
          "match": "https://localhost.emobix.co.uk:9443/oidc/authorize*",
          "optional": true,
          "commands": [
            [
              "wait",
              "xpath",
              "//*",
              10,
              "Invalid client or redirect URI",
              "update-image-placeholder"
            ]
          ]
        },
        {
          "task": "Sign in through Authkit",
          "match": "https://localhost.emobix.co.uk:9443/conformance/login*",
          "optional": true,
          "commands": [
            [
              "wait",
              "xpath",
              "//*",
              10,
              "Sign-in",
              "update-image-placeholder-optional"
            ],
            [
              "text",
              "name",
              "email",
              "oidf@example.test"
            ],
            [
              "text",
              "name",
              "password",
              "isolated-conformance-password"
            ],
            [
              "click",
              "name",
              "submit"
            ]
          ]
        },
        {
          "task": "Approve requested scopes",
          "match": "https://localhost.emobix.co.uk:9443/oidc/interaction*",
          "optional": true,
          "commands": [
            [
              "click",
              "css",
              "button[value=\"approve\"]"
            ]
          ]
        },
        {
          "task": "Complete authorization",
          "match": "https://localhost.emobix.co.uk:8443/test/*/callback*",
          "optional": true,
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              10
            ]
          ]
        }
      ]
    }
  ],
  "options": {
    "browsercontrol_css_enable": false
  }
}
